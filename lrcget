#!/bin/bash

# ###################################################################### #
# use ffprobe to read metadata from cli arg and output in json. we want  #
# artist, title, album, and duration.                                    #
#                                                                        #
# args: $1 - file to act on                                              #
#                                                                        #
# returns: 0 - success                                                   #
#                                                                        #
# json metadata output                                                   #
# {                                                                      #
#    "format": {                                                         #
#        "duration": "145.750000",                                       #
#        "tags": {                                                       #
#            "TITLE": "Another Place",                                   #
#            "ALBUM": "Ghost of Your Guitar Solo",                       #
#            "ARTIST": "MJ Lenderman"                                    #
#        }                                                               #
#    }                                                                   #
# }                                                                      #
# use exiftool for more consistent results                               #
# [{                                                                     #
#   Duration: "",                                                        #
#   Artist: "",                                                          #
#   Title: "",                                                           #
#   Album: "",                                                           #
# }]                                                                     #
# ###################################################################### #

get_metadata() {
  filename="$1"
#  ffprobe -v quiet -print_format json -show_entries format=duration -show_entries format_tags=album,title,artist "$filename"
  exiftool -j -Artist -Title -Album "$1"
} # get_metadata

get_duration() {
  ffprobe -v quiet -print_format csv -show_entries format=duration "$1"
}

# ###################################################################### #
# curl GET request with url encoded content. use /api/get with duration, #
# or /api/search if no duration. jq parses json response.                #
# uses syncedLyrics field if it exists, else use plainLyrics.            #
#                                                                        #
# args: $1 - file to act on                                              #
#                                                                        #
# returns: 0 - success finding synced lyrics                             #
#          1 - success finding plain lyrics                              #
#          2 - failed to find lyrics                                     #
#          3 - track is instrumental; no lyrics found                    #
# ###################################################################### #

api_get="https:/lrclib.net/api/get"
api_get_cached="https:/lrclib.net/api/get-cached"
api_search="https:/lrclib.net/api/search"
#TODO: use different api endpoints depending on status codes? 

# curl api/get
curl_get() {
  curl -G -H "User-Agent: lrcget/2000" \
    --data-urlencode "artist_name=$artist" \
    --data-urlencode "track_name=$title" \
    --data-urlencode "album_name=$album" \
    --data-urlencode "duration=$duration" \
    "$api_get"
}

# curl api/search
curl_search() {
  curl -G -H "User-Agent: lrcget/2000" \
    --data-urlencode "artist_name=$artist" \
    --data-urlencode "track_name=$title" \
    --data-urlencode "album_name=$album" \
    "$api_search"
}

request() {
  filename="$1"
  json_data=$(get_metadata "$filename")
  artist=$(echo "$json_data" | jq -r '.[0].Artist')
  title=$(echo "$json_data" | jq -r '.[0].Title')
  album=$(echo "$json_data" | jq -r '.[0].Album')
  duration=$(get_duration "$filename" | awk -F, '{ printf "%.0f", $2 }')
  if [[ $artist == "null" || $title == "null" || $album == "null" ]]; then
    log_to_file "ERROR: Metadata is null."
    return 1
  fi
  
  log_to_file "Finding lyrics for $artist - $title - $album ($duration s)."
  
  # curl api/get
  result=$(curl_get | jq -r 'if .instrumental? == true then {rc: 3} | tojson
                                elif .syncedLyrics? != null then {lyrics: .syncedLyrics, rc: 0} | tojson
			        elif .plainLyrics? != null then {lyrics: .plainLyrics, rc: 1} | tojson
			        else {rc: 2} | tojson end')

  rc=$(echo "$result" | jq -r '.rc')
  
  # use search endpoint if specifics failed
  if [ $rc -eq 2 ]; then
    log_to_file "ERROR: Track not found. Trying api/search."
    result=$(curl_search | jq -r 'if .[0].syncedLyrics? != null then {lyrics: .[0].syncedLyrics, rc: 0} | tojson
                                  elif .[0].plainLyrics? != null then {lyrics: .[0].plainLyrics, rc: 1 } | tojson
		                  else {rc: 2} | tojson end')
  
    rc=$(echo "$result" | jq -r '.rc')
    if [[ $rc -eq 0 || $rc -eq 1 ]]; then
      log_to_file "SUCCESS: Lyrics found using api/search. rc=$rc"
    elif [[ $rc -eq 2 ]]; then
      log_to_file "ERROR: Track not found in api/search."
    fi

  elif [[ $rc -eq 3 ]]; then
    log_to_file "WARNING: Did not find lyrics for instrumental track."
  else
    log_to_file "SUCCESS: Lyrics found using api/get."
  fi
  
  echo "$result" 
} # request

