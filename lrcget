# ###################################################################### #
# creates name for output .lrc file and calls request() to gather lyrics #
# args: $1 - audio filename to act on                                    #
#                                                                        #
# returns: -1 - failed to write to lyric file                            #
#           0 - success finding synced lyrics                            #
#           1 - success finding plain lyrics                             #
#           2 - failed to find lyrics                                    #
#           3 - track is instrumental; no lyrics found                   #
# ###################################################################### #

main() {
  filename="$1"
  lrc_file="${filename%.*}.lrc"
  txt_file="${filename%.*}.txt"

  # if lrc file does not exist
  if ! [[ -e $lrc_file ]]; then
    lrc_result=$(request "$filename")
    rc=$(echo "$lrc_result" | jq -r '.rc')
    lyrics=$(echo "$lrc_result" | jq -r '.lyrics')

    if [[ $rc -eq 0 ]]; then
      echo "$lyrics" > "$lrc_file" || (log_to_file "ERROR: Failed to write to $lrc_file"; exit -1)
      log_to_file "Synced Lyrics placed in $lrc_file."
    elif [[ $rc -eq 1 && ! -e $txt_file ]]; then
      echo "$lyrics" > "$txt_file" || (log_to_file "ERROR: Failed to write to $txt_file"; exit -1)
      log_to_file "Plain Lyrics placed in $txt_file."
    fi

    return $rc
  else
    log_to_file "Lyrics file already exists"
  fi
} # main

##################################################
##################################################
LOG_FILE=$(date +"%Y_%m_%d").log
# helper function to log to file
log_to_file() {
  echo "$(date +"%H:%M:%S") $1" >> $LOG_FILE
}

if [ -z "$1" ]; then
  echo "run with path to audio file!" 
elif [ -f "$1" ]; then
  main "$1"
else
  echo "file does not exist"
  echo "run with path to audio file!" 
  exit 1
fi

